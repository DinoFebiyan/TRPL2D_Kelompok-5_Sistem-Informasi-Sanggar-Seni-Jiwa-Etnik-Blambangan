# =============================================================
#  Jiwa Etnik Blambangan — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# =============================================================

# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------
APP_NAME="Jiwa Etnik Blambangan"

# Environment: local | staging | production
APP_ENV=local

# CRITICAL: Generate with: php artisan key:generate
APP_KEY=

# Set false in production!
APP_DEBUG=true

APP_URL=http://localhost

# Port exposed by Docker webserver (dev only)
APP_PORT=8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# -------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------
# Channels: stack | single | daily | slack | syslog | errorlog | null
LOG_CHANNEL=stack
LOG_STACK=single

# Levels: debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=debug

# -------------------------------------------------------------
# DATABASE — MySQL / MariaDB
# -------------------------------------------------------------
DB_CONNECTION=mysql

# Use 'db' when running inside Docker, '127.0.0.1' for local native
DB_HOST=127.0.0.1

# MySQL port (use 3307 if you run Docker MySQL alongside local MySQL)
DB_PORT=3306

DB_DATABASE=jeb_db
DB_USERNAME=root
DB_PASSWORD=

# MySQL port exposed to the host machine (Docker dev only)
DB_EXTERNAL_PORT=3307

# -------------------------------------------------------------
# SESSION
# -------------------------------------------------------------
# Drivers: file | cookie | database | memcached | redis | array
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------------------
# CACHE
# -------------------------------------------------------------
# Stores: database | file | redis | array
CACHE_STORE=database

# -------------------------------------------------------------
# QUEUE
# -------------------------------------------------------------
# Drivers: sync | database | redis | sqs
# Use 'sync' in local dev if you don't want to run a queue worker
QUEUE_CONNECTION=database

# -------------------------------------------------------------
# MAIL — Required for OTP Password Reset feature
# -------------------------------------------------------------
# Mailers: smtp | log | array | sendmail
# Use 'log' for local dev (emails appear in storage/logs/laravel.log)
MAIL_MAILER=log

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@jeb.id"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------
# FILESYSTEM
# -------------------------------------------------------------
# Disks: local | public | s3
FILESYSTEM_DISK=public

# -------------------------------------------------------------
# BROADCAST (not used — leave as null)
# -------------------------------------------------------------
BROADCAST_CONNECTION=null

# -------------------------------------------------------------
# GOOGLE RECAPTCHA
# -------------------------------------------------------------
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqySaR5QpCoQQJgA-tG1IiP
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFzsJjmvV5I8s

# -------------------------------------------------------------
# REDIS (optional — not required by default)
# -------------------------------------------------------------
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# -------------------------------------------------------------
# AWS S3 (optional — not required by default)
# -------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false
