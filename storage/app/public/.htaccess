<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|inc|html|htm)$">
    Order Deny,Allow
    Deny from all
    # Untuk Apache 2.4+ (komentar baris di atas, aktifkan baris di bawah)
    # Require all denied
</FilesMatch>

<IfModule mod_php5.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} .*\.(php|phtml|php3|php4|php5|php7|phar|inc|html|htm)$ [NC]
    RewriteRule .* - [F,L]
</IfModule>